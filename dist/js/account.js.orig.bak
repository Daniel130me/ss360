
// const { success } = require("toastr");

$(document).ready(function () {
    // Centralized handlers for billing UI. Cleaned and consolidated.

    // --- Share Receipt Button Logic ---
    $(document).on('click', '#shareReceiptButton', function () {
        const element = document.getElementById('printableReceipt');
        if (!element) return toastr.error('No receipt to share.');
        const $btn = $(this);
        $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Sharing...');
        html2pdf().from(element).outputPdf('blob').then(function (pdfBlob) {
            const file = new File([pdfBlob], 'receipt.pdf', { type: 'application/pdf' });
            if (navigator.canShare && navigator.canShare({ files: [file] })) {
                navigator.share({ files: [file], title: 'Payment Receipt', text: 'Here is your payment receipt.' })
                    .then(function () { $btn.prop('disabled', false).html('<i class="fas fa-share-alt"></i> Share'); toastr.success('Shared successfully!'); })
                    .catch(function (err) { $btn.prop('disabled', false).html('<i class="fas fa-share-alt"></i> Share'); if (err && err.name !== 'AbortError') fallbackShare(); });
            } else {
                fallbackShare();
            }

            function fallbackShare() {
                var formData = new FormData();
                formData.append('action', 'upload_receipt_pdf');
                formData.append('file', pdfBlob, 'receipt.pdf');
                $.ajax({
                    url: '../billing_controller.php', type: 'POST', data: formData, processData: false, contentType: false, dataType: 'json',
                    success: function (res) {
                        $btn.prop('disabled', false).html('<i class="fas fa-share-alt"></i> Share');
                        let shareHtml = '<div class="text-center mb-2">Share this receipt:</div><div class="d-flex justify-content-center">'
                            + (res.success && res.url ? '<a href="https://wa.me/?text=' + encodeURIComponent('Here is your payment receipt: ' + res.url) + '" target="_blank" class="btn btn-success mr-2"><i class="fab fa-whatsapp"></i> WhatsApp</a>' : '')
                            + '<button class="btn btn-primary" id="emailShareBtn"><i class="fas fa-envelope"></i> Email</button></div>';
                        let $modal = $('#shareReceiptModal');
                        if ($modal.length === 0) {
                            $('body').append('<div class="modal fade" id="shareReceiptModal" tabindex="-1" role="dialog"><div class="modal-dialog modal-dialog-centered" role="document"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Share Receipt</h5><button type="button" class="close" data-dismiss="modal"><span>&times;</span></button></div><div class="modal-body" id="shareReceiptModalBody"></div></div></div></div>');
                            $modal = $('#shareReceiptModal');
                        }
                        $('#shareReceiptModalBody').html(shareHtml);
                        $modal.modal('show');
                        $modal.off('click', '#emailShareBtn').on('click', '#emailShareBtn', function () {
                            let email = prompt('Enter recipient email:'); if (!email) return;
                            const reader = new FileReader();
                            reader.onload = function (e) {
                                const base64data = e.target.result.split(',')[1];
                                $.ajax({ url: '../billing_controller.php', type: 'POST', contentType: 'application/json', dataType: 'json', data: JSON.stringify({ action: 'email_receipt_pdf_data', email: email, pdf_base64: base64data }),
                                    success: function (resp) { if (resp.success) toastr.success('Receipt sent via email!'); else toastr.error(resp.message || 'Failed to send email.'); }, error: function () { toastr.error('Failed to send email.'); }
                                });
                            };
                            reader.readAsDataURL(pdfBlob);
                        });
                    },
                    error: function () { $btn.prop('disabled', false).html('<i class="fas fa-share-alt"></i> Share'); toastr.error('Failed to upload receipt for sharing.'); }
                });
            }
        });
    });

    // --- Unified Payment Receipt Modal Logic ---
    function showPaymentReceiptModal(options = { billId: null, paymentId: null, studentId: null, last: false }) {
        const { billId, paymentId = null, studentId = null, last = false } = options;
        const $modal = $('#paymentReceiptPreviewModal'); const $content = $('#paymentReceiptContent');
        $content.html('<div class="text-center text-muted p-5"><i class="fas fa-spinner fa-spin fa-2x"></i><br>Loading receipt...</div>'); $modal.modal('show');
        // account.js - cleaned and consolidated
        // Minimal, syntactically-correct reconstruction preserving key features.

        $(document).ready(function () {
            function money(val) { return '₦' + Number(val || 0).toLocaleString(); }
            function escapeHtml(s) { if (typeof s !== 'string') return s; return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#039;'); }

            // Share receipt (uses html2pdf and fallback upload)
            $(document).on('click', '#shareReceiptButton', function () {
                var el = document.getElementById('printableReceipt');
                if (!el) { toastr.error('No receipt to share.'); return; }
                var $btn = $(this);
                $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Sharing...');
                html2pdf().from(el).outputPdf('blob').then(function (blob) {
                    try {
                        var file = new File([blob], 'receipt.pdf', { type: 'application/pdf' });
                        if (navigator.canShare && navigator.canShare({ files: [file] })) {
                            navigator.share({ files: [file], title: 'Payment Receipt', text: 'Here is your payment receipt.' })
                                .then(function () { $btn.prop('disabled', false).html('<i class="fas fa-share-alt"></i> Share'); toastr.success('Shared'); })
                                .catch(function () { $btn.prop('disabled', false).html('<i class="fas fa-share-alt"></i> Share'); toastr.info('Share cancelled'); });
                            return;
                        }
                    } catch (e) { /* navigator share unsupported */ }

                    // Fallback: upload to server then show sharing options
                    var fd = new FormData(); fd.append('action', 'upload_receipt_pdf'); fd.append('file', blob, 'receipt.pdf');
                    $.ajax({ url: '../billing_controller.php', type: 'POST', data: fd, processData: false, contentType: false, dataType: 'json',
                        success: function (res) {
                            $btn.prop('disabled', false).html('<i class="fas fa-share-alt"></i> Share');
                            var html = '<div class="text-center mb-2">Share this receipt:</div><div class="d-flex justify-content-center">';
                            if (res && res.success && res.url) html += '<a class="btn btn-success mr-2" target="_blank" href="https://wa.me/?text=' + encodeURIComponent('Receipt: ' + res.url) + '"><i class="fab fa-whatsapp"></i> WhatsApp</a>';
                            html += '<button class="btn btn-primary" id="emailShareBtn"><i class="fas fa-envelope"></i> Email</button></div>';
                            var $modal = $('#shareReceiptModal');
                            if ($modal.length === 0) { $('body').append('<div class="modal fade" id="shareReceiptModal" tabindex="-1" role="dialog"><div class="modal-dialog modal-dialog-centered" role="document"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Share Receipt</h5><button type="button" class="close" data-dismiss="modal"><span>&times;</span></button></div><div class="modal-body" id="shareReceiptModalBody"></div></div></div></div>'); $modal = $('#shareReceiptModal'); }
                            $('#shareReceiptModalBody').html(html); $modal.modal('show');
                            $modal.off('click', '#emailShareBtn').on('click', '#emailShareBtn', function () {
                                var email = prompt('Enter recipient email:'); if (!email) return;
                                var reader = new FileReader(); reader.onload = function (e) { var b64 = e.target.result.split(',')[1]; $.ajax({ url: '../billing_controller.php', type: 'POST', contentType: 'application/json', data: JSON.stringify({ action: 'email_receipt_pdf_data', email: email, pdf_base64: b64 }), success: function (r) { if (r && r.success) toastr.success('Sent'); else toastr.error('Failed'); }, error: function () { toastr.error('Failed'); } }); }; reader.readAsDataURL(blob);
                            });
                        },
                        error: function () { $btn.prop('disabled', false).html('<i class="fas fa-share-alt"></i> Share'); toastr.error('Upload failed'); }
                    });
                }).catch(function () { $btn.prop('disabled', false).html('<i class="fas fa-share-alt"></i> Share'); toastr.error('PDF generation failed'); });
            });

            // Show payment receipt modal (fetches HTML data via AJAX)
            function showPaymentReceiptModal(opts) {
                opts = opts || {}; var billId = opts.billId || null; var paymentId = opts.paymentId || null; var studentId = opts.studentId || null; var last = !!opts.last;
                var $modal = $('#paymentReceiptPreviewModal'); var $content = $('#paymentReceiptContent'); $content.html('<div class="text-center p-4 text-muted"><i class="fas fa-spinner fa-spin"></i> Loading...</div>'); $modal.modal('show');
                var termId = $('.term_btn.select_btn.active').attr('data-id') || $('#select_term_field').val(); var sessionId = $('#select_session_field').val();
                var data = { bill_id: billId }; if (termId) data.term_id = termId; if (sessionId) data.session_id = sessionId; if (last) { data.action = 'get_last_payment_receipt'; data.student_id = studentId; } else { data.action = 'get_payment_receipt'; data.payment_id = paymentId; }
                $.ajax({ url: '../billing_controller.php', type: 'POST', dataType: 'json', data: data,
                    success: function (res) {
                        if (!res || !res.success || !res.data) { $content.html('<div class="alert alert-danger">Failed to load receipt.</div>'); return; }
                        var d = res.data; var student = d.student || {}; var bill = d.bill || {}; var billType = d.bill_type || {}; var payment = d.payment || {}; var breakdown = [];
                        try { breakdown = bill.bill_items ? JSON.parse(bill.bill_items) : []; } catch (e) { breakdown = []; }
                        var html = '<div id="printableReceipt" class="p-3">';
                        html += '<div class="row align-items-center mb-2"><div class="col-2">' + (d.school_logo ? '<img src="../uploads/' + d.school_logo + '" style="max-width:80px">' : '') + '</div><div class="col-10"><h4>' + (d.school_name || '') + '</h4><div>Payment Receipt</div></div></div><hr>';
                        html += '<div><b>Student:</b> ' + (student.firstname || '') + ' ' + (student.lastname || '') + ' | <b>Admission:</b> ' + (student.admission_no || '') + '</div>';
                        html += '<table class="table table-sm mt-2"><thead><tr><th>Description</th><th class="text-right">Amount</th></tr></thead><tbody>';
                        if (breakdown && breakdown.length) { breakdown.forEach(function (it) { var desc = (it.description || (Object.keys(it)[0] || 'Item')); var amt = (it.amount || it[Object.keys(it)[0]] || 0); html += '<tr><td>' + escapeHtml(desc) + '</td><td class="text-right">' + money(amt) + '</td></tr>'; }); }
                        else { html += '<tr><td>' + (billType.bill_name || 'Fee') + '</td><td class="text-right">' + money(bill.amount) + '</td></tr>'; }
                        html += '</tbody></table><div class="mt-2"><b>Total Paid:</b> ' + money(payment.amount_newly_paid) + ' | <b>Balance:</b> ' + money(payment.balance) + '</div>';
                        html += '</div>';
                        $content.html(html);
                    }, error: function () { $content.html('<div class="alert alert-danger">Failed to load receipt.</div>'); }
                });
            }
            window.showPaymentReceiptModal = showPaymentReceiptModal;

            // Print and download
            $(document).on('click', '#printReceiptButton', function () { var el = document.getElementById('printableReceipt'); if (!el) return; var w = window.open('', '', 'height=700,width=900'); w.document.write('<html><head><title>Receipt</title>'); w.document.write('<link rel="stylesheet" href="../dist/css/adminlte.css">'); w.document.write('</head><body>'); w.document.write(el.outerHTML); w.document.write('</body></html>'); w.document.close(); w.focus(); setTimeout(function () { w.print(); w.close(); }, 500); });
            $(document).on('click', '#downloadReceiptButton', function () { var el = document.getElementById('printableReceipt'); if (!el) return; html2pdf().from(el).set({ filename: 'receipt.pdf' }).save(); });

            // Payment timeline modal
            window.showPaymentRecordModal = function (billId, studentId) {
                $('#paymentRecordModal').modal('show'); var $c = $('#paymentTimelineContainer'); $c.html('<div class="text-center text-muted">Loading...</div>');
                $.ajax({ url: '../billing_controller.php', type: 'POST', dataType: 'json', data: { action: 'get_payment_timeline', bill_id: billId, student_id: studentId }, success: function (res) {
                    if (!res || !res.success || !res.data || !res.data.length) { $c.html('<div class="alert alert-warning">No records.</div>'); return; }
                    var html = '<div class="timeline">'; var last = '';
                    res.data.forEach(function (it) { var date = it.date_paid || it.datecreated || ''; var label = date ? new Date(date).toLocaleDateString() : ''; if (label && label !== last) { html += '<div class="time-label"><span class="bg-info">' + label + '</span></div>'; last = label; } var icon = 'fa-money-bill-wave', bg = 'bg-success'; if (it.status == 0) { icon = 'fa-hourglass-half'; bg = 'bg-warning'; } if (it.balance > 0 && it.amount_newly_paid == 0) { icon = 'fa-exclamation-circle'; bg = 'bg-danger'; } html += '<div><i class="fas ' + icon + ' ' + bg + '"></i><div class="timeline-item"><h3 class="timeline-header">' + money(it.amount_newly_paid) + '</h3><div class="timeline-body"><div><b>Description:</b> ' + (it.description || '') + '</div></div></div></div>'; });
                    html += '</div>';
                    $c.html(html);
                }, error: function () { $c.html('<div class="alert alert-danger">Failed to load.</div>'); } });
            };

            // Simple invoice helper (keeps minimal behavior)
            function setupInvoiceForm(opts) {
                var addBtn = opts.addRowBtn; var body = opts.tableBody; var rc = opts.removeRowClass; var cls = opts.rowClass; var subtotal = opts.subtotalId; var disc = opts.discountId; var tax = opts.taxId; var total = opts.totalId;
                $(document).on('click', addBtn, function () { $(body).append('<tr><td><input required class="form-control ' + cls + '-description" name="' + cls + '_description[]"></td><td><input required class="form-control ' + cls + '-amount" name="' + cls + '_amount[]" type="number" step="0.01" min="0"></td><td><button type="button" class="btn btn-danger ' + rc + '">Remove</button></td></tr>'); });
                $(document).on('click', '.' + rc, function () { $(this).closest('tr').remove(); updateInvoiceTotal(opts); });
                $(document).on('input', '.' + cls + '-amount, ' + disc + ', ' + tax, function () { updateInvoiceTotal(opts); });
                updateInvoiceTotal(opts);
            }
            function updateInvoiceTotal(opts) { var sum = 0; $('.' + opts.rowClass + '-amount').each(function () { sum += parseFloat($(this).val()) || 0; }); $(opts.subtotalId).val(sum.toFixed(2)); var d = parseFloat($(opts.discountId).val()) || 0; var t = parseFloat($(opts.taxId).val()) || 0; var taxable = sum - (d / 100 * sum); var taxVal = taxable * (t / 100); $(opts.totalId).val((taxable + taxVal).toFixed(2)); }

            // initialize common forms (IDs from original app)
            try { setupInvoiceForm({ addRowBtn: '#addQuickAssignBreakdownRow', tableBody: '#quickAssignInvoiceBreakdownTable tbody', rowClass: 'quick-assign-breakdown', removeRowClass: 'remove-quick-assign-breakdown-row', subtotalId: '#quick_assign_subtotal', discountId: '#quick_assign_deduction_percentage', taxId: '#quick_assign_tax', totalId: '#quick_assign_total_amount' }); } catch (e) {}
            try { setupInvoiceForm({ addRowBtn: '#addBreakdownRow', tableBody: '#invoiceBreakdownTable tbody', rowClass: 'breakdown', removeRowClass: 'remove-breakdown-row', subtotalId: '#subtotal', discountId: '#deduction_percentage', taxId: '#editBillTaxPercentage', totalId: '#totalAmountInvoice' }); } catch (e) {}

            // Term selection reloads data
            $(document).on('click', '.term_btn.select_btn', function () { $('.term_btn.select_btn').removeClass('active'); $(this).addClass('active'); if (typeof fetchAndDisplayEstimatedIncome === 'function') fetchAndDisplayEstimatedIncome(); if ($.fn.DataTable && $('#student_payment_recordTable').length) $('#student_payment_recordTable').DataTable().ajax.reload(); });

        });
            }
        });
    }
    $(document).on('click', '.term_btn.select_btn', function () {
        $('.term_btn.select_btn').removeClass('active');
        $(this).addClass('active');
        // If you want to trigger a reload or AJAX here, do it now
        // For example, reload the DataTable or trigger any dependent logic
        if (typeof fetchAndDisplayEstimatedIncome === 'function') fetchAndDisplayEstimatedIncome();
        if ($.fn.DataTable && $('#student_payment_recordTable').length) {
            $('#student_payment_recordTable').DataTable().ajax.reload();
        }
    });

    // Print and Download buttons for receipt (shared)
    $(document).on('click', '#printReceiptButton', function () {
        const printContents = document.getElementById('printableReceipt');
        if (!printContents) return;
        const win = window.open('', '', 'height=700,width=900');
        win.document.write('<html><head><title>Print Receipt</title>');
        win.document.write('<link rel="stylesheet" href="../dist/css/adminlte.css">');
        win.document.write('<link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">');
        win.document.write(`<style>
            @media print { 
                body { padding: 0; margin: 0; }
                .report-card { page-break-after: always; page-break-inside: avoid; }
                .report-card:last-child { page-break-after: avoid; }
            }
            </style>`);
        win.document.write('</head><body >');
        win.document.write(printContents.outerHTML);
        win.document.write('</body></html>');
        win.document.close();
        win.focus();
        setTimeout(function () { win.print(); win.close(); }, 500);
    });
});
        }
    });

    // --- Payment Record Timeline Modal Logic ---
    window.showPaymentRecordModal = function (billId, studentId) {
        $('#paymentRecordModal').modal('show');
        const $container = $('#paymentTimelineContainer');
        $container.html('<div class="text-center text-muted">Loading payment records...</div>');
        $.ajax({
            url: '../billing_controller.php',
            method: 'POST',
            dataType: 'json',
            data: {
                action: 'get_payment_timeline',
                bill_id: billId,
                student_id: studentId
            },
            success: function (res) {
                if (!res.success || !Array.isArray(res.data) || res.data.length === 0) {
                    $container.html('<div class="alert alert-warning text-center">No payment records found for this bill.</div>');
                    return;
                }
                // Group by date for timeline labels
                let timeline = '<div class="timeline">';
                let lastDate = '';
                res.data.forEach(function (item, idx) {
                    // Format date for label (YYYY-MM-DD to e.g. 21 Jun. 2025)
                    let dateObj = item.date_paid ? new Date(item.date_paid) : (item.datecreated ? new Date(item.datecreated) : null);
                    let dateLabel = dateObj ? dateObj.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) : '';
                    if (dateLabel && dateLabel !== lastDate) {
                        timeline += `<div class="time-label"><span class="bg-info">${dateLabel}</span></div>`;
                        lastDate = dateLabel;
                    }
                    // Icon and color
                    let icon = 'fa-money-bill-wave', bg = 'bg-success', statusText = 'Paid', statusColor = 'text-success';
                    if (item.status == 0) { statusText = 'Pending'; bg = 'bg-warning'; icon = 'fa-hourglass-half'; statusColor = 'text-warning'; }
                    if (item.balance > 0 && item.amount_newly_paid == 0) { statusText = 'Outstanding'; bg = 'bg-danger'; icon = 'fa-exclamation-circle'; statusColor = 'text-danger'; }
                    // Timeline item
                    timeline += `
                      <div>
                        <i class="fas ${icon} ${bg}"></i>
                        <div class="timeline-item">
                        <a href="#paymentReceiptPreviewModal" class="float-right" data-toggle="modal" aria-expanded="false" data-bill_id="${item.bill_id}" data-paymentid="${item.id}" aria-controls="paymentReceiptPreviewModal">Preview Payment Receipt</a>
                          <h3 class="timeline-header ${statusColor}">
                            <b>${statusText}</b> - ₦${Number(item.amount_newly_paid).toLocaleString()} paid
                          </h3>
                          <div class="timeline-body">
                            <div><b>Description:</b> ${item.description || 'No description'}</div>
                            <div><b>Payment Method:</b> ${item.payment_method || 'N/A'}</div>
                            <div><b>Total Amount Paid To Date:</b> ₦${Number(item.total_amount_paid).toLocaleString()}</div>
                            <div><b>Balance:</b> <span class="${item.balance > 0 ? 'text-danger' : 'text-success'}">₦${Number(item.balance).toLocaleString()}</span></div>
                          </div>
                        </div>
                      </div>
                    `;
                });
                timeline += '<div><i class="fas fa-flag-checkered bg-gray"></i></div></div>';
                $container.html(timeline);
            },
            error: function () {
                $container.html('<div class="alert alert-danger text-center">Failed to load payment records.</div>');
            }
        });
    };
    // Unified handler for both preview and last receipt
    $(document).on('click', 'a[data-toggle="modal"][data-bill_id][data-paymentid][aria-controls="paymentReceiptPreviewModal"]', function (e) {
        e.preventDefault();
        showPaymentReceiptModal({
            billId: $(this).data('bill_id'),
            paymentId: $(this).data('paymentid')
        });
    });
    $(document).on('click', '.generate-last-receipt', function () {
        showPaymentReceiptModal({
            billId: $(this).data('bill_id'),
            studentId: $(this).data('student_id'),
            last: true
        });
    });
    // ...existing code...
    // --- Quick Assign Bill Modal: Invoice Logic ---
    // Setup for Quick Assign Bill Form (Invoice) with add/remove and live calculation
    setupInvoiceForm({
        addRowBtn: '#addQuickAssignBreakdownRow',
        tableBody: '#quickAssignInvoiceBreakdownTable tbody',
        rowClass: 'quick-assign-breakdown',
        removeRowClass: 'remove-quick-assign-breakdown-row',
        subtotalId: '#quick_assign_subtotal',
        discountId: '#quick_assign_deduction_percentage',
        taxId: '#quick_assign_tax',
        totalId: '#quick_assign_total_amount'
    });

    // Preview functionality for Quick Assign Bill
    $('#quickPreviewBillButton').on('click', function () {
        // Gather Data
        const billTypeId = $('#quick_assign_bill_type').val();
        const billTypeName = $('#quick_assign_bill_type option:selected').text();
        const subtotal = $('#quick_assign_subtotal').val();
        const deductionPurpose = $('#quick_assign_deduction_purpose').val();
        const deductionPercentage = $('#quick_assign_deduction_percentage').val();
        const tax = $('#quick_assign_tax').val();
        const totalAmount = $('#quick_assign_total_amount').val();
        const notes = $('#quick_assign_notes').val();
        const terms = $('#quick_assign_terms').val();
        const studentName = $('#quick_assign_student_name').val();

        // Gather breakdown items
        let breakdownHtml = '';
        let hasBreakdown = false;
        $('#quickAssignInvoiceBreakdownTable tbody tr').each(function () {
            const desc = $(this).find('input').eq(0).val();
            const amt = $(this).find('input').eq(1).val();

            // const desc = $(this).find('input[name="quick_assign_breakdown_description[]"]').val();
            // const amt = $(this).find('input[name="quick_assign_breakdown_amount[]"]').val();
            if (desc && amt !== undefined && amt !== null && amt !== '') {
                breakdownHtml += `<tr><td>${desc}</td><td>${parseFloat(amt).toLocaleString()}</td></tr>`;
                hasBreakdown = true;
            }
        });

        // Validation
        let errors = [];
        if (!billTypeId) errors.push("Please select a Bill Type.");
        if (totalAmount === '' || isNaN(parseFloat(totalAmount)) || parseFloat(totalAmount) < 0) errors.push("Please enter a valid Total Amount.");
        if (tax === '' || isNaN(parseFloat(tax)) || parseFloat(tax) < 0) errors.push("Please enter a valid Tax percentage (use 0 if none).");
        if (!studentName) errors.push("Student name missing.");
        if (!hasBreakdown) errors.push("Please add at least one breakdown item.");
        if (errors.length > 0) {
            toastr.warning(errors.join('<br>'), 'Missing Information');
            return;
        }

        // Format Preview HTML
        let previewHtml = `
                    <h4>Student</h4>
                    <p><strong>${studentName}</strong></p>
                    <h4>Bill Type</h4>
                    <p>${billTypeName}</p>
                    <h4>Bill Breakdown</h4>
                    <table class="table table-bordered mb-4">
                        <thead><tr><th>Description</th><th>Amount</th></tr></thead>
                        <tbody>${breakdownHtml}</tbody>
                    </table>
                    <table class="table table-sm table-bordered mb-4">
                        <tr><th>Subtotal</th><td>${parseFloat(subtotal).toLocaleString()}</td></tr>
                        <tr><th>Deduction Purpose</th><td>${deductionPurpose}</td></tr>
                        <tr><th>Deduction (%)</th><td>${deductionPercentage}</td></tr>
                        <tr><th>Tax (%)</th><td>${tax}</td></tr>
                        <tr><th>Total</th><td><strong>${parseFloat(totalAmount).toLocaleString()}</strong></td></tr>
                        <tr><th>Notes</th><td>${notes}</td></tr>
                        <tr><th>Terms</th><td>${terms}</td></tr>
                    </table>
                `;
        $('#quickPreviewBillContent').html(previewHtml);
        $('#quick-preview-bill-tab-link').tab('show');
    });

    // Optionally, reset preview content on modal show
    $('#quickAssignBillModal').on('show.bs.modal', function () {
        var $quickSelect = $('#quick_assign_bill_type');
        // if ($quickSelect.data('select2')) {
        //     $quickSelect.select2('destroy');
